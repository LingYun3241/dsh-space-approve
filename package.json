{
  "name": "dsh-space-approve",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "description": "Approve a pending DSH approval prompt with the Space key (allow-once only, typing-safe) and reject it with Escape 鈥?no click required.",
  "author": "LingYun3241",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingYun3241/dsh-space-approve.git"
  },
  "homepage": "https://github.com/LingYun3241/dsh-space-approve#readme",
  "bugs": {
    "url": "https://github.com/LingYun3241/dsh-space-approve/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "keyboard-shortcuts",
    "space"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0"
    },
    "manifestVersion": 1
  },
  "license": "MIT"
}
